{
  "name": "PDF Bench",
  "short_name": "PDF Bench",
  "description": "Split, merge, combine and bulk-rename PDFs. Works offline; files never leave your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#e9edf3",
  "theme_color": "#2f4bff",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/pdf": [".pdf"] } }
  ],
  "shortcuts": [
    { "name": "Split PDFs", "url": "./?tool=split" },
    { "name": "Merge PDFs", "url": "./?tool=merge" },
    { "name": "Rename PDFs", "url": "./?tool=rename" }
  ]
}
